rules_version = '2';

// Reglas de Firestore. Hay que pegarlas en la consola de Firebase
// (Firestore Database -> Reglas -> Publicar) CADA VEZ que cambien.
//
// Si no se publican, Firestore se queda como estaba y la web dará errores de permisos
// en Amigos y Versus (o, en modo de prueba, cualquiera podría leerlo todo).
//
// Resumen:
//   usuarios/{uid}/datos  -> privado: equipos, rutas, level caps. Solo su dueño.
//   perfiles/{uid}        -> lo lee cualquiera identificado, de uno en uno (hace falta para
//                            ver el palmarés de un amigo). Lo escribe su dueño. Sin correo.
//   motes/{mote}          -> qué cuenta tiene cada mote. Uno por persona, sin repetidos.
//   correos/{correo}      -> de quién es cada correo de Google. Solo se puede mirar uno
//                            sabiéndolo entero: no se puede sacar la lista.
//   presencia/{uid}       -> cuándo se vio a cada uno con la web abierta. Lo escribe su dueño.
//   amistades/{par}       -> solo los dos implicados. El id es los dos uid ordenados.
//   lockes/{id}           -> solo los que juegan ese locke. Cada uno toca SOLO sus vidas,
//                            sus victorias y su respuesta a la invitación. Nombre, juego,
//                            ganador y cerrarlo: solo quien lo creó. Si lo marca como «publico», cualquiera con
//                            su enlace lo lee (y su actividad), sin sesión.

service cloud.firestore {
  match /databases/{database}/documents {

    function identificado() {
      return request.auth != null;
    }

    // ---------- Datos privados ----------

    match /usuarios/{uid}/datos/{clave} {
      allow read, write: if identificado() && request.auth.uid == uid;
    }

    // ---------- Perfil público ----------
    //
    // Lleva nombre, foto, los tipos de locke que usa esa persona y su palmarés. Nada
    // privado: es la ficha que ven tus amigos. El correo no puede ir aquí (antes iba).
    //
    // «get» y no «read»: se lee el de alguien sabiendo su uid, pero no se puede pedir la
    // colección entera.

    match /perfiles/{uid} {
      // Si el perfil pasa a tener un mote, ese mote tiene que estar reservado a su nombre en
      // motes/ al terminar la escritura (se hace todo en el mismo lote)
      function moteBien() {
        let mote = request.resource.data.get('mote', '');
        return mote == ''
          || (resource != null && resource.data.get('mote', '') == mote)
          || getAfter(/databases/$(database)/documents/motes/$(mote.lower())).data.uid == uid;
      }

      allow get: if identificado();
      allow create, update: if identificado() && request.auth.uid == uid && moteBien()
        && !request.resource.data.keys().hasAny(['correo']);
      allow delete: if identificado() && request.auth.uid == uid;
    }

    // ---------- Correos ----------
    //
    // Para buscar a alguien de Google por su correo. Cada uno apunta solo el suyo (el que
    // dice Google, no uno inventado).

    match /correos/{correo} {
      allow get: if identificado();
      allow create, update: if identificado()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == correo
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if identificado() && resource.data.uid == request.auth.uid;
    }

    // ---------- Conectado ----------
    //
    // Cada uno apunta en el suyo la hora (la del servidor, no vale inventársela) y si está
    // conectado. Lo puede leer cualquiera con sesión: solo dice cuándo se vio por última vez.

    match /presencia/{uid} {
      allow read: if identificado();
      allow create, update: if identificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['visto', 'conectado'])
        && request.resource.data.visto == request.time
        && request.resource.data.conectado is bool;
      allow delete: if identificado() && request.auth.uid == uid;
    }

    // ---------- Motes ----------
    //
    // Un documento por mote, con el id en minúsculas: como Firestore no deja crear uno que
    // ya existe, no puede haber dos personas con el mismo. Solo se puede tener uno: al crear
    // o reescribir, tu perfil tiene que acabar apuntando a él; al borrarlo, ya no.
    //
    // Se puede mirar sin sesión: el formulario de crear cuenta comprueba si el usuario está libre.

    match /motes/{clave} {
      // Si el perfil se borra en la misma escritura (al borrar la cuenta), como uno vacío
      function miPerfilDespues() {
        let perfil = getAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid));
        return perfil == null ? {} : perfil.data;
      }

      allow get: if true;
      allow create: if identificado()
        && clave.matches('^[a-z0-9_.-]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mote.lower() == clave
        && miPerfilDespues().get('mote', '').lower() == clave;
      // Solo para cambiar mayúsculas («pepe» -> «Pepe»): el dueño no cambia
      allow update: if identificado()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mote.lower() == clave
        && miPerfilDespues().get('mote', '').lower() == clave;
      allow delete: if identificado()
        && resource.data.uid == request.auth.uid
        && miPerfilDespues().get('mote', '').lower() != clave;
    }

    // ---------- Amistades ----------
    //
    // Un documento por pareja, con el id formado por los dos uid ordenados y unidos con
    // "_". Así no pueden existir dos solicitudes de lo mismo. Cualquiera de los dos puede
    // aceptarla o borrarla.

    match /amistades/{par} {
      allow create: if identificado()
        && request.auth.uid in request.resource.data.miembros
        && request.resource.data.miembros.size() == 2;
      allow read, update, delete: if identificado()
        && request.auth.uid in resource.data.miembros;
    }

    // ---------- Lockes (sección Versus) ----------
    //
    // Todos los de dentro lo ven y pueden escribir en él, pero con límites:
    //
    //   · resultados de los combates y reacciones del cementerio: cualquiera de dentro.
    //   · vidas, marcador, estados, muertos, rom, salon y equipos (de cada combate) son mapas {uid: valor}. Cada uno solo puede CAMBIAR o
    //     QUITAR su propia entrada. Solo se pueden AÑADIR entradas de jugadores que entran
    //     en esta misma escritura (al invitar a alguien se le ponen sus vidas iniciales).
    //   · nombres y fotos: lo mismo; la propia se puede cambiar (al cambiarse el mote).
    //   · jugadores: se puede añadir gente (invitar), quitarse a uno mismo (rechazar) y echar
    //     a alguien de uno en uno, nombrado en «quitado»: a un invitado que aún no ha
    //     contestado cualquiera de dentro; a cualquiera (menos a sí mismo) quien lo creó.
    //   · contado: cada uno solo se apunta a sí mismo (lo usa el ganador).
    //   · nombre, tipo, juego, normas, rutas y level caps propios, ganador, cerrar...: solo
    //     quien lo creó.
    //   · borrarlo: solo quien lo creó.
    //   · publico (solo quien lo creó): cualquiera que sepa el id lo lee de uno en uno, sin sesión.
    //     El id es un código largo al azar: sin el enlace no hay forma de encontrarlo (no se
    //     puede pedir la lista), y apagando «publico» el enlace deja de valer.

    match /lockes/{id} {
      function yo() {
        return request.auth.uid;
      }

      function soloYo() {
        return [request.auth.uid].toSet();
      }

      function antes() {
        return resource.data;
      }

      function despues() {
        return request.resource.data;
      }

      // Jugadores que entran con esta escritura (los invitados nuevos)
      function entran() {
        return despues().jugadores.toSet().difference(antes().jugadores.toSet());
      }

      function cambios(campo) {
        return despues().get(campo, {}).diff(antes().get(campo, {}));
      }

      // Quién puede salir con esta escritura: uno mismo y, si la escritura lo dice en
      // «quitado», un invitado que todavía no había contestado (lo echa otro de dentro) o
      // cualquiera menos el creador si quien lo echa es el creador
      function quitado() {
        return despues().get('quitado', '');
      }

      function sePuedeEchar() {
        return quitado() in antes().jugadores
          && quitado() != antes().creador
          && (antes().get('estados', {}).get(quitado(), '') == 'pendiente' || antes().creador == yo());
      }

      function puedenSalir() {
        return sePuedeEchar() ? soloYo().union([quitado()].toSet()) : soloYo();
      }

      // Las entradas de un mapa {uid: valor} que cambian, se quitan y se añaden con esta
      // escritura, cada una dentro de quien puede hacerlo.
      //
      // OJO: Firestore no evalúa más de 1.000 expresiones por escritura, y si se pasa la
      // rechaza aunque esté bien. Por eso quién puede qué (puedenSalir, entran...) se calcula
      // una sola vez en mapasBien() y se pasa aquí, en vez de volver a calcularlo para cada
      // mapa: así se rechazaba todo (guardar el locke, las reacciones...).
      function mapaBien(campo, cambiables, quitables, anadibles) {
        let c = cambios(campo);
        return c.changedKeys().difference(cambiables).size() == 0
          && c.removedKeys().difference(quitables).size() == 0
          && c.addedKeys().difference(anadibles).size() == 0;
      }

      //   · vidas, marcador y estados: cada uno cambia el suyo; se añaden los que entran.
      //   · muertos, rom, salon, equipos y medallas: igual, pero el propio puede no existir todavía (la lista
      //     del cementerio se crea con el primer muerto).
      //   · nombres y fotos: cambian los que entran ahora (alguien que rechazó y vuelve a ser
      //     invitado ya los tenía, y pueden haber cambiado) y el propio (al cambiarse el mote).
      // Y nadie sale de la lista de jugadores salvo quien puede salir.
      function mapasBien() {
        let mio = soloYo();
        let salen = puedenSalir();
        let nuevos = entran();
        let nuevosOMio = nuevos.union(mio);
        return mapaBien('vidas', mio, salen, nuevos)
          && mapaBien('marcador', mio, salen, nuevos)
          && mapaBien('estados', mio, salen, nuevos)
          && mapaBien('muertos', mio, salen, nuevosOMio)
          && mapaBien('rom', mio, salen, nuevosOMio)
          && mapaBien('salon', mio, salen, nuevosOMio)
          && mapaBien('equipos', mio, salen, nuevosOMio)
          && mapaBien('medallas', mio, salen, nuevosOMio)
          && mapaBien('nombres', nuevosOMio, mio, nuevos)
          && mapaBien('fotos', nuevosOMio, mio, nuevos)
          && antes().jugadores.toSet().difference(despues().jugadores.toSet()).difference(salen).size() == 0;
      }

      function contadoBien() {
        return antes().get('contado', []).toSet()
            .difference(despues().get('contado', []).toSet()).size() == 0
          && despues().get('contado', []).toSet()
            .difference(antes().get('contado', []).toSet())
            .difference(soloYo()).size() == 0;
      }

      function cosasDelCreador() {
        return antes().creador == yo()
          || !despues().diff(antes()).affectedKeys().hasAny([
            'nombre', 'descripcion', 'tipo', 'juego', 'juegoOtro', 'juegoPropio', 'estado', 'ganador',
            'fechaFin', 'creador', 'vidasIniciales', 'vidasIlimitadas', 'creado', 'normas',
            'rutasPropias', 'capsPropios', 'randomizer', 'arbitro', 'publico', 'cadena', 'combates'
          ]);
      }

      allow read: if identificado() && yo() in antes().jugadores;
      allow get: if antes().get('publico', false) == true;

      allow create: if identificado()
        && yo() in despues().jugadores
        && despues().creador == yo();

      allow update: if identificado()
        && yo() in antes().jugadores
        && despues().creador == antes().creador
        && mapasBien()
        && contadoBien()
        && cosasDelCreador();

      allow delete: if identificado() && yo() == antes().creador;
    }

    // ---------- Actividad de un locke ----------
    //
    // Lo que va pasando (vidas, victorias, muertos...). La ven los que juegan el locke. Cada
    // uno apunta solo lo suyo, con la hora del servidor, y puede borrar lo suyo (al deshacer
    // un clic sin querer). Quien creó el locke lo borra todo al borrar el locke.

    match /lockes/{id}/actividad/{suceso} {
      function locke() {
        return get(/databases/$(database)/documents/lockes/$(id)).data;
      }

      allow read: if (identificado() && request.auth.uid in locke().jugadores)
        || locke().get('publico', false) == true;
      allow create: if identificado()
        && request.auth.uid in locke().jugadores
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cuando == request.time
        && request.resource.data.tipo is string
        && request.resource.data.keys().hasOnly(['uid', 'tipo', 'cuando', 'delta', 'muerto', 'ganador', 'detalle']);
      allow delete: if identificado()
        && (resource.data.uid == request.auth.uid || locke().creador == request.auth.uid);

      // Reacciones: cualquiera de dentro, solo en su propia entrada de «reacciones» ({uid: emoji})
      // y sin tocar nada más del suceso.
      allow update: if identificado()
        && request.auth.uid in locke().jugadores
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones'])
        && request.resource.data.reacciones.diff(resource.data.get('reacciones', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reacciones)
          || (request.resource.data.reacciones[request.auth.uid] is string
            && request.resource.data.reacciones[request.auth.uid].size() <= 8));
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
