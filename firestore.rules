rules_version = '2';

// Reglas de Firestore. Hay que pegarlas en la consola de Firebase
// (Firestore Database -> Reglas -> Publicar) CADA VEZ que cambien.
//
// Si no se publican, Firestore se queda como estaba y la web dará errores de permisos
// en Amigos y Versus (o, en modo de prueba, cualquiera podría leerlo todo).
//
// Resumen:
//   usuarios/{uid}/datos  -> privado: equipos, rutas, level caps. Solo su dueño.
//   perfiles/{uid}        -> lo lee cualquiera identificado, de uno en uno (hace falta para
//                            ver el palmarés de un amigo). Lo escribe su dueño. Sin correo.
//   motes/{mote}          -> qué cuenta tiene cada mote. Uno por persona, sin repetidos.
//   correos/{correo}      -> ya no se usa (antes: buscar por correo). Cada uno solo puede borrar el suyo.
//   presencia/{uid}       -> cuándo se vio a cada uno con la web abierta. Lo escribe su dueño.
//   amistades/{par}       -> solo los dos implicados. El id es los dos uid ordenados.
//   lockes/{id}           -> solo los que juegan ese locke. Cada uno toca SOLO sus vidas,
//                            sus victorias y su respuesta a la invitación. Nombre, juego,
//                            ganador y cerrarlo: solo quien lo creó. Si lo marca como «publico», cualquiera con
//                            su enlace lo lee (y su actividad), sin sesión.
//   foro/{id}             -> hilos del foro y, dentro, sus comentarios. Los lee cualquiera con sesión.
//                            Cada uno escribe lo suyo; los moderadores (moderadores/{uid}, a mano en la
//                            consola) pueden borrar y fijar. Ver «Foro» más abajo.
//   denuncias/{id}        -> solo la leen los moderadores. Cualquiera con sesión puede crearlas.
//   silenciados, ritmo    -> quién no puede escribir en el foro, y el freno de 20 s entre mensajes.
//   estadisticas/usuarios -> cuántos perfiles hay (solo un número). Lo lee cualquiera, incluso sin
//                            sesión. Solo cambia de 1 en 1, junto con la creación o el borrado del
//                            perfil propio. El documento se crea a mano (ver LEEME-nube.md).

service cloud.firestore {
  match /databases/{database}/documents {

    function identificado() {
      return request.auth != null;
    }

    // Quien tiene un documento en moderadores/ (se apunta a mano en la consola)
    function esMod() {
      return request.auth != null
        && exists(/databases/$(database)/documents/moderadores/$(request.auth.uid));
    }

    // El administrador: un moderador cuyo documento dice rol: "admin" (se pone a mano en la
    // consola). Es el único que nombra y quita moderadores.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/moderadores/$(request.auth.uid))
        && get(/databases/$(database)/documents/moderadores/$(request.auth.uid)).data.get('rol', '') == 'admin';
    }

    // Quien tiene un documento en silenciados/: no puede escribir en el foro
    function silenciado() {
      return exists(/databases/$(database)/documents/silenciados/$(request.auth.uid));
    }

    // Quien ya ha elegido su mote. Para escribir en el foro hace falta: así nadie aparece
    // ahí con un nombre que no ha elegido (la web ya obliga a elegirlo al entrar, esto lo
    // asegura también para quien se salte la web).
    function tieneMote() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.get('mote', '') != '';
    }

    // ---------- Datos privados ----------

    // Solo se pueden escribir las claves que la web sincroniza de verdad (CLAVES_SINCRONIZADAS
    // en js/comun/almacen.js), con la forma { valor, actualizado }. Sin esto, una cuenta podría
    // crear miles de documentos con nombres inventados y llenar el espacio de la base de datos.
    // OJO: si se añade una clave nueva a CLAVES_SINCRONIZADAS, hay que añadirla aquí también o
    // esa clave se quedará sin subir a la nube (en silencio).
    match /usuarios/{uid}/datos/{clave} {
      function claveValida() {
        return clave in [
          'poketeams-equipo-v1', 'poketeams-equipos-v1', 'poketeams-actual-v1',
          'poketeams-equipos-orden-v1', 'poketeams-equipos-vista-v1', 'poketeams-grupos-v1',
          'poketeams-rutas-v2', 'poketeams-capturas-v1', 'poketeams-rutas-juego-v1',
          'poketeams-rutas-hierba-v1', 'poketeams-levelcaps-v2', 'poketeams-levelcaps-juego-v1',
          'poketeams-levelcaps-multiplicador-v1', 'poketeams-normas-v2', 'poketeams-contadores-v1',
          'poketeams-ruletas-v1', 'poketeams-rutas-propias-v1', 'poketeams-levelcaps-propios-v1',
          'poketeams-partidas-v1', 'poketeams-registrados-v1', 'poketeams-lockes-quitados-v1',
          'poketeams-avisos-arbitro-v1', 'poketeams-ajustes-v1', 'poketeams-juegos-propios-v1'
        ];
      }

      allow read, delete: if identificado() && request.auth.uid == uid;
      allow create, update: if identificado() && request.auth.uid == uid
        && claveValida()
        && request.resource.data.keys().hasOnly(['valor', 'actualizado'])
        && request.resource.data.valor is string
        && request.resource.data.actualizado is number;
    }

    // ---------- Perfil público ----------
    //
    // Lleva nombre, foto, los tipos de locke que usa esa persona y su palmarés. Nada
    // privado: es la ficha que ven tus amigos. El correo no puede ir aquí (antes iba).
    //
    // «get» y no «read»: se lee el de alguien sabiendo su uid, pero no se puede pedir la
    // colección entera.

    match /perfiles/{uid} {
      // Si el perfil pasa a tener un mote, ese mote tiene que estar reservado a su nombre en
      // motes/ al terminar la escritura (se hace todo en el mismo lote)
      function moteBien() {
        let mote = request.resource.data.get('mote', '');
        return mote == ''
          || (resource != null && resource.data.get('mote', '') == mote)
          || getAfter(/databases/$(database)/documents/motes/$(mote.lower())).data.uid == uid;
      }

      allow get: if identificado();
      allow create, update: if identificado() && request.auth.uid == uid && moteBien()
        && !request.resource.data.keys().hasAny(['correo']);
      allow delete: if identificado() && request.auth.uid == uid;
    }

    // ---------- Cuántos usuarios hay ----------
    //
    // Un único documento con un número: nada de uids ni de datos de nadie. Se crea a mano en la
    // consola con el total de ahora (campo «total», tipo número). Después solo sube 1 cuando una
    // persona crea SU perfil y baja 1 cuando borra el suyo, en el mismo lote (por eso se mira el
    // perfil antes y después de la escritura).

    match /estadisticas/usuarios {
      function miPerfil() {
        return /databases/$(database)/documents/perfiles/$(request.auth.uid);
      }

      allow get: if true;
      allow update: if identificado()
        && request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total is int
        && (
          (!exists(miPerfil()) && existsAfter(miPerfil())
            && request.resource.data.total == resource.data.total + 1)
          || (exists(miPerfil()) && !existsAfter(miPerfil())
            && resource.data.total > 0
            && request.resource.data.total == resource.data.total - 1)
        );
    }

    // ---------- Correos (ya no se usan) ----------
    //
    // Antes servían para buscar a alguien de Google por su correo. Ya no se puede buscar por
    // correo (así nadie puede comprobar si un correo usa la web), y no se crean más. Solo queda
    // que cada uno pueda mirar y borrar el apunte que tuviera de antes con SU correo.

    match /correos/{correo} {
      allow get, delete: if identificado()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == correo;
    }

    // ---------- Conectado ----------
    //
    // Cada uno apunta en el suyo la hora (la del servidor, no vale inventársela) y si está
    // conectado. Lo puede leer cualquiera con sesión, de uno en uno (se mira el de un amigo
    // sabiendo su uid; no se puede pedir la lista): solo dice cuándo se vio por última vez.

    match /presencia/{uid} {
      allow get: if identificado();
      allow create, update: if identificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['visto', 'conectado'])
        && request.resource.data.visto == request.time
        && request.resource.data.conectado is bool;
      allow delete: if identificado() && request.auth.uid == uid;
    }

    // ---------- Motes ----------
    //
    // Un documento por mote, con el id en minúsculas: como Firestore no deja crear uno que
    // ya existe, no puede haber dos personas con el mismo. Solo se puede tener uno: al crear
    // o reescribir, tu perfil tiene que acabar apuntando a él; al borrarlo, ya no.
    //
    // Se puede mirar sin sesión: el formulario de crear cuenta comprueba si el usuario está libre.

    match /motes/{clave} {
      // Si el perfil se borra en la misma escritura (al borrar la cuenta), como uno vacío
      function miPerfilDespues() {
        let perfil = getAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid));
        return perfil == null ? {} : perfil.data;
      }

      allow get: if true;
      allow create: if identificado()
        && clave.matches('^[a-z0-9_.-]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mote.lower() == clave
        && miPerfilDespues().get('mote', '').lower() == clave;
      // Solo para cambiar mayúsculas («pepe» -> «Pepe»): el dueño no cambia
      allow update: if identificado()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mote.lower() == clave
        && miPerfilDespues().get('mote', '').lower() == clave;
      allow delete: if identificado()
        && resource.data.uid == request.auth.uid
        && miPerfilDespues().get('mote', '').lower() != clave;
    }

    // ---------- Amistades ----------
    //
    // Un documento por pareja, con el id formado por los dos uid ordenados y unidos con
    // "_". Así no pueden existir dos solicitudes de lo mismo. Cualquiera de los dos puede
    // aceptarla o borrarla.

    //
    // Pedirla: siempre «pendiente», a nombre de quien la pide, con el id correcto y los dos uid
    // ordenados (como lo hace pedirAmistad). Aceptarla: solo la otra persona, y lo único que
    // cambia es el estado. Antes cualquiera podía crearla ya aceptada o aceptar la suya.
    match /amistades/{par} {
      allow create: if identificado()
        && request.resource.data.keys().hasOnly(['miembros', 'estado', 'pidio', 'creado'])
        && request.resource.data.miembros is list
        && request.resource.data.miembros.size() == 2
        && request.auth.uid in request.resource.data.miembros
        && request.resource.data.miembros[0] < request.resource.data.miembros[1]
        && par == request.resource.data.miembros[0] + '_' + request.resource.data.miembros[1]
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.pidio == request.auth.uid
        && request.resource.data.creado is number;
      allow read, delete: if identificado()
        && request.auth.uid in resource.data.miembros;
      allow update: if identificado()
        && request.auth.uid in resource.data.miembros
        && resource.data.get('pidio', '') != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'ok';
    }

    // ---------- Lockes (sección Versus) ----------
    //
    // Todos los de dentro lo ven y pueden escribir en él, pero con límites:
    //
    //   · resultados de los combates y reacciones del cementerio: cualquiera de dentro.
    //   · vidas, marcador, estados, muertos, rom, salon y equipos (de cada combate) son mapas {uid: valor}. Cada uno solo puede CAMBIAR o
    //     QUITAR su propia entrada. Solo se pueden AÑADIR entradas de jugadores que entran
    //     en esta misma escritura (al invitar a alguien se le ponen sus vidas iniciales).
    //   · nombres y fotos: lo mismo; la propia se puede cambiar (al cambiarse el mote).
    //   · jugadores: se puede añadir gente (invitar), quitarse a uno mismo (rechazar) y echar
    //     a alguien de uno en uno, nombrado en «quitado»: a un invitado que aún no ha
    //     contestado cualquiera de dentro; a cualquiera (menos a sí mismo) quien lo creó.
    //   · contado: cada uno solo se apunta a sí mismo (lo usa el ganador).
    //   · nombre, tipo, juego, normas, rutas y level caps propios, ganador, cerrar...: solo
    //     quien lo creó.
    //   · borrarlo: solo quien lo creó.
    //   · publico (solo quien lo creó): cualquiera que sepa el id lo lee de uno en uno, sin sesión.
    //     El id es un código largo al azar: sin el enlace no hay forma de encontrarlo (no se
    //     puede pedir la lista), y apagando «publico» el enlace deja de valer.

    match /lockes/{id} {
      function yo() {
        return request.auth.uid;
      }

      function soloYo() {
        return [request.auth.uid].toSet();
      }

      function antes() {
        return resource.data;
      }

      function despues() {
        return request.resource.data;
      }

      // Jugadores que entran con esta escritura (los invitados nuevos)
      function entran() {
        return despues().jugadores.toSet().difference(antes().jugadores.toSet());
      }

      function cambios(campo) {
        return despues().get(campo, {}).diff(antes().get(campo, {}));
      }

      // Quién puede salir con esta escritura: uno mismo y, si la escritura lo dice en
      // «quitado», un invitado que todavía no había contestado (lo echa otro de dentro) o
      // cualquiera menos el creador si quien lo echa es el creador
      function quitado() {
        return despues().get('quitado', '');
      }

      function sePuedeEchar() {
        return quitado() in antes().jugadores
          && quitado() != antes().creador
          && (antes().get('estados', {}).get(quitado(), '') == 'pendiente' || antes().creador == yo());
      }

      function puedenSalir() {
        return sePuedeEchar() ? soloYo().union([quitado()].toSet()) : soloYo();
      }

      // Las entradas de un mapa {uid: valor} que cambian, se quitan y se añaden con esta
      // escritura, cada una dentro de quien puede hacerlo.
      //
      // OJO: Firestore no evalúa más de 1.000 expresiones por escritura, y si se pasa la
      // rechaza aunque esté bien. Por eso quién puede qué (puedenSalir, entran...) se calcula
      // una sola vez en mapasBien() y se pasa aquí, en vez de volver a calcularlo para cada
      // mapa: así se rechazaba todo (guardar el locke, las reacciones...).
      function mapaBien(campo, cambiables, quitables, anadibles) {
        let c = cambios(campo);
        return c.changedKeys().difference(cambiables).size() == 0
          && c.removedKeys().difference(quitables).size() == 0
          && c.addedKeys().difference(anadibles).size() == 0;
      }

      //   · vidas, marcador y estados: cada uno cambia el suyo; se añaden los que entran.
      //   · muertos, rom, salon, equipos y medallas: igual, pero el propio puede no existir todavía (la lista
      //     del cementerio se crea con el primer muerto).
      //   · nombres y fotos: cambian los que entran ahora (alguien que rechazó y vuelve a ser
      //     invitado ya los tenía, y pueden haber cambiado) y el propio (al cambiarse el mote).
      // Y nadie sale de la lista de jugadores salvo quien puede salir.
      function mapasBien() {
        let mio = soloYo();
        let salen = puedenSalir();
        let nuevos = entran();
        let nuevosOMio = nuevos.union(mio);
        return mapaBien('vidas', mio, salen, nuevos)
          && mapaBien('marcador', mio, salen, nuevos)
          && mapaBien('estados', mio, salen, nuevos)
          && mapaBien('muertos', mio, salen, nuevosOMio)
          && mapaBien('rom', mio, salen, nuevosOMio)
          && mapaBien('salon', mio, salen, nuevosOMio)
          && mapaBien('equipos', mio, salen, nuevosOMio)
          && mapaBien('medallas', mio, salen, nuevosOMio)
          && mapaBien('nombres', nuevosOMio, mio, nuevos)
          && mapaBien('fotos', nuevosOMio, mio, nuevos)
          && antes().jugadores.toSet().difference(despues().jugadores.toSet()).difference(salen).size() == 0;
      }

      function contadoBien() {
        return antes().get('contado', []).toSet()
            .difference(despues().get('contado', []).toSet()).size() == 0
          && despues().get('contado', []).toSet()
            .difference(antes().get('contado', []).toSet())
            .difference(soloYo()).size() == 0;
      }

      function cosasDelCreador() {
        return antes().creador == yo()
          || !despues().diff(antes()).affectedKeys().hasAny([
            'nombre', 'descripcion', 'tipo', 'juego', 'juegoOtro', 'juegoPropio', 'estado', 'ganador',
            'fechaFin', 'creador', 'vidasIniciales', 'vidasIlimitadas', 'creado', 'normas',
            'rutasPropias', 'capsPropios', 'randomizer', 'arbitro', 'publico', 'cadena', 'combates'
          ]);
      }

      allow read: if identificado() && yo() in antes().jugadores;
      allow get: if antes().get('publico', false) == true;

      allow create: if identificado()
        && yo() in despues().jugadores
        && despues().creador == yo();

      allow update: if identificado()
        && yo() in antes().jugadores
        && despues().creador == antes().creador
        && mapasBien()
        && contadoBien()
        && cosasDelCreador();

      allow delete: if identificado() && yo() == antes().creador;
    }

    // ---------- Actividad de un locke ----------
    //
    // Lo que va pasando (vidas, victorias, muertos...). La ven los que juegan el locke. Cada
    // uno apunta solo lo suyo, con la hora del servidor, y puede borrar lo suyo (al deshacer
    // un clic sin querer). Quien creó el locke lo borra todo al borrar el locke.

    match /lockes/{id}/actividad/{suceso} {
      function locke() {
        return get(/databases/$(database)/documents/lockes/$(id)).data;
      }

      allow read: if (identificado() && request.auth.uid in locke().jugadores)
        || locke().get('publico', false) == true;
      allow create: if identificado()
        && request.auth.uid in locke().jugadores
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cuando == request.time
        && request.resource.data.tipo is string
        && request.resource.data.keys().hasOnly(['uid', 'tipo', 'cuando', 'delta', 'muerto', 'ganador', 'detalle']);
      allow delete: if identificado()
        && (resource.data.uid == request.auth.uid || locke().creador == request.auth.uid);

      // Reacciones: cualquiera de dentro, solo en su propia entrada de «reacciones» ({uid: emoji})
      // y sin tocar nada más del suceso.
      allow update: if identificado()
        && request.auth.uid in locke().jugadores
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones'])
        && request.resource.data.reacciones.diff(resource.data.get('reacciones', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reacciones)
          || (request.resource.data.reacciones[request.auth.uid] is string
            && request.resource.data.reacciones[request.auth.uid].size() <= 8));
    }

    // ---------- Moderación ----------
    //
    // Los moderadores y los silenciados se apuntan A MANO en la consola de Firebase (Firestore
    // Database -> Datos). Desde la web no se puede ser moderador ni darse a uno mismo permisos:
    // sin servidor propio, esa es la única forma de que nadie se los dé.
    //
    //   moderadores/{uid}  -> un documento por moderador (el id es su uid): { rol, por, desde }.
    //                         El tuyo lleva rol: "admin" (a mano). Cada uno puede mirar el suyo, para
    //                         que la web sepa si enseñarle el panel; los moderadores miran los de los
    //                         demás. Solo el admin nombra moderadores (rol «moderador», nunca otro
    //                         admin) y los quita, y no puede tocar el documento de un admin.
    //   silenciados/{uid}  -> { desde, motivo, por }. Quien está aquí no puede escribir en el
    //                         foro. Lo crean y lo quitan los moderadores; el silenciado puede ver
    //                         el suyo (para que la web le explique por qué no le deja).

    match /moderadores/{uid} {
      allow get: if identificado() && (request.auth.uid == uid || esMod());
      allow list: if esMod();
      // Nombrar: crear el documento de otra persona (si ya existe sería una modificación, y esa
      // no se deja: así tampoco se le puede quitar el rol «admin» a nadie desde la web)
      allow create: if esAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['rol', 'por', 'desde'])
        && request.resource.data.rol == 'moderador'
        && request.resource.data.por == request.auth.uid
        && request.resource.data.desde == request.time;
      allow delete: if esAdmin() && resource.data.get('rol', '') != 'admin';
    }

    match /silenciados/{uid} {
      allow get: if identificado() && (request.auth.uid == uid || esMod());
      allow list: if esMod();
      allow create, update: if esMod()
        && request.resource.data.keys().hasOnly(['desde', 'motivo', 'por'])
        && request.resource.data.por == request.auth.uid;
      allow delete: if esMod();
    }

    // ---------- Ritmo ----------
    //
    // Freno contra el spam: cada hilo o comentario nuevo va en el mismo lote que la marca
    // «cuando» de esta persona, y no se deja una marca nueva hasta 20 segundos después de la
    // anterior. El foro (abajo) exige esa marca en cada escritura nueva.

    match /ritmo/{uid} {
      allow create: if identificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cuando'])
        && request.resource.data.cuando == request.time;
      allow update: if identificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cuando'])
        && request.resource.data.cuando == request.time
        && request.time >= resource.data.cuando + duration.value(20, 's');
      allow delete: if identificado() && request.auth.uid == uid;
    }

    // ---------- Foro ----------
    //
    // Solo con sesión: cualquiera identificado lee los hilos y sus comentarios.
    //
    //   foro/{id}                    { uid, titulo, texto, categoria, juego, juegoOtro, tipo,
    //                                  huecos, creado, ultimo, respuestas, cerrado, fijado }
    //   foro/{id}/comentarios/{cid}  { uid, texto, creado }
    //
    //   · Crear un hilo: cualquiera que no esté silenciado, con la hora del servidor, sin respuestas
    //     y con la marca de ritmo en el mismo lote. Solo un moderador puede crearlo ya fijado (un
    //     hilo «principal»: sale destacado arriba del todo).
    //   · Editar un hilo: su autor (título, texto, tipo de hilo, juego, tipo de locke, huecos y «cerrado»). Quien comenta
    //     solo puede subir «respuestas» en 1 y poner «ultimo», y solo si en ese mismo lote crea
    //     su comentario. Fijar un hilo: solo moderadores.
    //   · El id de un comentario es «uid_N», con N el número de respuestas que deja el hilo:
    //     así comentar y subir el contador van siempre juntos y no se puede inflar uno sin el otro.
    //     (Al borrar un comentario el contador no baja: si bajase, el id volvería a repetirse.)
    //   · Borrar: su autor, el autor del hilo (comentarios) y los moderadores.

    match /foro/{id} {
      function nuevo() {
        return request.resource.data;
      }

      function textosBien() {
        return nuevo().titulo is string && nuevo().titulo.size() >= 3 && nuevo().titulo.size() <= 100
          && nuevo().texto is string && nuevo().texto.size() <= 2000
          && nuevo().categoria in ['busco', 'general', 'ayuda']
          && nuevo().get('juego', '') is string && nuevo().get('juego', '').size() <= 30
          && nuevo().get('juegoOtro', '') is string && nuevo().get('juegoOtro', '').size() <= 60
          && nuevo().get('tipo', '') is string && nuevo().get('tipo', '').size() <= 30
          && nuevo().get('huecos', 0) is int && nuevo().get('huecos', 0) >= 0 && nuevo().get('huecos', 0) <= 20
          && nuevo().cerrado is bool;
      }

      function marcaDeRitmo() {
        return getAfter(/databases/$(database)/documents/ritmo/$(request.auth.uid)).data.cuando == request.time;
      }

      allow read: if identificado();

      // Cualquiera crea hilos, pero solo un moderador puede crearlos fijados («principales»)
      allow create: if identificado() && !silenciado() && tieneMote()
        && nuevo().keys().hasOnly(['uid', 'titulo', 'texto', 'categoria', 'juego', 'juegoOtro', 'tipo', 'huecos',
          'creado', 'ultimo', 'respuestas', 'cerrado', 'fijado'])
        && nuevo().get('fijado', false) is bool
        && (nuevo().get('fijado', false) == false || esMod())
        && nuevo().uid == request.auth.uid
        && nuevo().creado == request.time
        && nuevo().ultimo == request.time
        && nuevo().respuestas == 0
        && textosBien()
        && marcaDeRitmo();

      allow update: if identificado() && (
        // Un moderador: cualquier cosa menos de quién es
        (esMod() && nuevo().uid == resource.data.uid)
        // Su autor
        || (resource.data.uid == request.auth.uid && !silenciado()
          && nuevo().diff(resource.data).affectedKeys().hasOnly(['titulo', 'texto', 'categoria', 'juego', 'juegoOtro', 'tipo', 'huecos', 'cerrado'])
          && textosBien())
        // Quien comenta
        || (!silenciado()
          && nuevo().diff(resource.data).affectedKeys().hasOnly(['respuestas', 'ultimo'])
          && nuevo().respuestas == resource.data.respuestas + 1
          && nuevo().ultimo == request.time
          && existsAfter(/databases/$(database)/documents/foro/$(id)/comentarios/$(request.auth.uid + '_' + string(nuevo().respuestas)))
          && marcaDeRitmo())
      );

      allow delete: if identificado() && (resource.data.uid == request.auth.uid || esMod());
    }

    match /foro/{id}/comentarios/{cid} {
      function hilo() {
        return get(/databases/$(database)/documents/foro/$(id)).data;
      }

      function hiloDespues() {
        return getAfter(/databases/$(database)/documents/foro/$(id)).data;
      }

      allow read: if identificado();

      allow create: if identificado() && !silenciado() && tieneMote()
        && request.resource.data.keys().hasOnly(['uid', 'texto', 'creado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.creado == request.time
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 1000
        && hiloDespues().respuestas == hilo().respuestas + 1
        && cid == request.auth.uid + '_' + string(hiloDespues().respuestas)
        && getAfter(/databases/$(database)/documents/ritmo/$(request.auth.uid)).data.cuando == request.time;

      allow delete: if identificado()
        && (resource.data.uid == request.auth.uid || hilo().uid == request.auth.uid || esMod());
    }

    // Todos los comentarios de una persona (para borrarlos al borrar su cuenta). Pide un
    // índice compuesto de «grupo de colección» (uid + creado) de «comentarios» (ver LEEME-nube.md).
    match /{ruta=**}/comentarios/{cid} {
      allow read: if identificado();
    }

    // ---------- Denuncias ----------
    //
    // Cualquiera con sesión denuncia un hilo, un comentario o a una persona. El id es
    // «quien denuncia_lo denunciado», así que no se puede denunciar dos veces lo mismo ni
    // escribir en el id de otro. Solo los moderadores las leen, las resuelven y las borran.
    //
    //   denuncias/{id}  { de, tipo, hilo, comentario, autor, motivo, nota, copia, creado }
    //   (copia: el texto tal como estaba al denunciarlo, por si luego lo cambian o lo borran)

    match /denuncias/{id} {
      allow create: if identificado()
        && id.matches(request.auth.uid + '_.+')
        && request.resource.data.keys().hasOnly(['de', 'tipo', 'hilo', 'comentario', 'autor', 'motivo', 'nota', 'copia', 'creado'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.tipo in ['hilo', 'comentario', 'usuario']
        && request.resource.data.motivo in ['spam', 'acoso', 'ofensivo', 'engano', 'otro']
        && request.resource.data.creado == request.time
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 300
        && request.resource.data.copia is string && request.resource.data.copia.size() <= 700;
      allow read, update, delete: if esMod();
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
